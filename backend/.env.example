# LLM（供应商在 config.py 的 LLM_PROVIDER 切换：deepseek | anthropic）
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 兼容：若 LLM_PROVIDER=anthropic 才需要以下 key
# CLAUDE_API_KEY=sk-ant-...

# 百度地图（覆盖天气/POI/地址搜索/路线规划，lbsyun.baidu.com 申请 AK）
BAIDU_MAP_AK=...
# BAIDU_MAP_SK=...  # 可选，SN 校验模式时填写

# 可选外部数据源（未配置则自动降级，规则兜底仍可用）
# Amadeus（真实航班/酒店）
# AMADEUS_API_KEY=...
# AMADEUS_API_SECRET=...
# Google Places / Maps（境外 POI）
# GOOGLE_PLACES_API_KEY=...
# GOOGLE_MAPS_API_KEY=...

# OpenWeatherMap
OPENWEATHER_API_KEY=...

# Exchange Rate
EXCHANGE_RATE_API_KEY=...

# 数据库
# 本地开发默认使用 SQLite（无需安装 Postgres）：
#   DATABASE_URL=sqlite+aiosqlite:///./travel_planner.db
# Docker 部署（docker-compose.yml 自带 Postgres）时改用下面这组配置：
POSTGRES_USER=travel_planner
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=travel_planner
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://travel_planner:dev_password@localhost:5432/travel_planner
DATABASE_URL_SYNC=postgresql+psycopg2://travel_planner:dev_password@localhost:5432/travel_planner

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth（可选）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
